    {
      "id": "e15c2710-f8f8-15f5-01e1-a263175d113c",
      "parameters": {
        "jsCode": "// Validate the prescription (docs/API.md, R4). Bad values get a 400 with a clear message.\n// These become hard rules for every dose check, so nothing is guessed or rounded silently.\nconst b = $input.first().json.body || {};\nconst num = (x) => (x === null || x === undefined || x === '' ? NaN : Number(x));\nconst drug = String(b.drug ?? '').trim();\nconst doseMg = num(b.doseMg), minIntervalH = num(b.minIntervalH), maxMg24h = num(b.maxMg24h), goal = num(b.goal);\nlet error = null;\nif (drug.length < 1 || drug.length > 40) error = 'Medication name must be 1 to 40 characters';\nelse if (!(doseMg > 0 && doseMg <= 1000)) error = 'Dose must be more than 0 mg (up to 1000 mg)';\nelse if (!(minIntervalH >= 1 && minIntervalH <= 24)) error = 'Hours between doses must be from 1 to 24';\nelse if (!(maxMg24h >= doseMg && maxMg24h <= 10000)) error = 'Daily maximum must be at least one dose (' + doseMg + ' mg)';\nelse if (!(Number.isInteger(goal) && goal >= 0 && goal <= 10)) error = 'Pain goal must be a whole number from 0 to 10';\nreturn [{ json: { valid: !error, error, patientId: String(b.patientId || 'P001'), drug, doseMg, minIntervalH, maxMg24h, goal } }];"
      },
      "name": "Check request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "notes": "dose > 0, interval 1-24 h, max >= dose, goal 0-10",
      "notesInFlow": true,
      "position": [
        220,
        300
      ]
    },
    {
      "id": "15e59cdf-ff4c-d2b4-3fdd-b286d2977d8d",
      "parameters": {
