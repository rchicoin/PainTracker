    {
      "id": "3d281bf7-dd7e-611d-8ab7-60ed48653997",
      "parameters": {
        "jsCode": "// Only the fields the patient can change; name stays as it is\nconst c = $('Check request').first().json;\nconst old = $input.all().map((i) => i.json).find((r) => r && String(r.patientId) === c.patientId);\nif (!old) throw new Error('No prescription row for patient ' + c.patientId);\nreturn [{ json: { patientId: c.patientId, drug: c.drug, doseMg: c.doseMg, minIntervalH: c.minIntervalH, maxMg24h: c.maxMg24h, goal: c.goal } }];"
      },
      "name": "Prescription row",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
