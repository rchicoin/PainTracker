    {
      "id": "25503592-0686-6e84-f5a1-7af53bbf6e0a",
      "parameters": {
        "jsCode": "// Reply: { ok, message, patient } (same patient shape as /dashboard)\nconst c = $('Check request').first().json;\nconst old = $('Get prescription').all().map((i) => i.json).find((r) => r && String(r.patientId) === c.patientId) || {};\nreturn [{ json: { ok: true, message: 'Saved. PainPal will use these limits from now on.',\n  patient: { name: old.name, goal: c.goal, drug: c.drug, doseMg: c.doseMg, minIntervalH: c.minIntervalH, maxMg24h: c.maxMg24h } } }];"
      },
