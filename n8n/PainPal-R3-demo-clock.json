    {
      "id": "a24d1c12-7b9f-768b-faa0-cabdea1f89d8",
      "parameters": {
        "jsCode": "// New offset = old + advance (max 7 days ahead), or 0 on reset\nconst c = $('Check request').first().json;\nconst row = $('Get demo_clock').all().map((i) => i.json).find((r) => r && String(r.patientId) === c.patientId);\nconst old = row && Number.isFinite(Number(row.offsetMin)) ? Number(row.offsetMin) : 0;\nconst offsetMin = c.reset ? 0 : Math.min(7 * 24 * 60, old + c.advanceMinutes);\nreturn [{ json: { patientId: c.patientId, offsetMin, exists: !!row } }];"
      },
      "name": "New offset",
      "type": "n8n-nodes-base.code",
