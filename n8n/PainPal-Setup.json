    {
      "parameters": {
        "url": "https://raw.githubusercontent.com/rchicoin/PainTracker/main/n8n/seed/prescription.csv",
        "options": {
          "response": {
            "response": {
              "responseFormat": "text",
              "outputPropertyName": "data"
            }
          }
        }
      },
      "name": "Download prescription.csv",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        4180,
        200
      ],
      "executeOnce": true,
      "id": "setup-19-download-prescription-csv"
    },
    {
      "parameters": {
        "jsCode": "// CSV text -> one item per row, with numbers as numbers and empty cells as null\nconst NUMBERS = [\"goal\",\"doseMg\",\"minIntervalH\",\"maxMg24h\"];\nconst text = $input.first().json.data;\nconst [head, ...lines] = text.trim().split(/\\r?\\n/);\nconst split = (line) => { const out = []; let cur = '', q = false;\n  for (let i = 0; i < line.length; i++) { const c = line[i];\n    if (q) { if (c === '\"' && line[i + 1] === '\"') { cur += '\"'; i++; } else if (c === '\"') q = false; else cur += c; }\n    else if (c === '\"') q = true; else if (c === ',') { out.push(cur); cur = ''; } else cur += c; }\n  out.push(cur); return out; };\nconst cols = split(head);\nreturn lines.map((line) => {\n  const v = split(line), row = {};\n  cols.forEach((c, i) => { row[c] = NUMBERS.includes(c) ? (v[i] === '' ? null : Number(v[i])) : v[i]; });\n  return { json: row };\n});"
      },
      "name": "Parse prescription",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        4400,
        400
      ],
      "id": "setup-20-parse-prescription"
    },
